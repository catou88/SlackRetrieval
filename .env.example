# Slack *user* token (starts with xoxp-) from your Slack app's "OAuth & Permissions" page.
SLACK_USER_TOKEN=xoxp-your-token
# Anthropic API key for answers/briefs (https://console.anthropic.com)
ANTHROPIC_API_KEY=sk-ant-your-key
# Optional overrides
# CLAUDE_MODEL=claude-opus-5-5
# DATA_DIR=data

# Browser-session alternative (no app needed): xoxc- token + d cookie
# SLACK_COOKIE=xoxd-...

# --- Hackathon intel (optional) ---
# Open-source Qwen via any OpenAI-compatible server (default: Ollama).
# QWEN_BASE_URL=http://localhost:11434/v1
# QWEN_MODEL=qwen3:8b
# Raises GitHub API rate limits; read-only public access needs no scopes.
# GITHUB_TOKEN=
# Minimum ms between requests to one host (never below 1000).
# INTEL_MIN_INTERVAL_MS=1000
# Optional: your workspace URL so job posts found in Slack link to the message.
# SLACK_WORKSPACE_URL=https://yourteam.slack.com
